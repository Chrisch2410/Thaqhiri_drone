<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>thaqhiri_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch files that compose the Thaqhiri system</description>
  <maintainer email="ubuntu@todo.todo">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>
  <exec_depend>thaqhiri_description</exec_depend>
  <exec_depend>thaqhiri_sim_webots</exec_depend>
  <exec_depend>thaqhiri_perception</exec_depend>
  <exec_depend>thaqhiri_navigation</exec_depend>

  <!-- Used by tools/evaluation/run_sil.py, which runs against this bringup. -->
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>webots_ros2_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
