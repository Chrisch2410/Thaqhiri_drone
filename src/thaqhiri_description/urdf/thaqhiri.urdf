<?xml version="1.0"?>
<robot name="thaqhiri">
  <!-- Webots driver/plugin configuration lives in
       thaqhiri_sim_webots/resource/webots_plugins.urdf. -->
  <!-- KNOWN ISSUE: base_link keeps the Webots/Blender axes (x=left, y=up,
       z=forward) via the rpy below instead of REP-105 FLU. See
       docs/architecture/frames_and_tf.md before changing it. -->
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0.155 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.25 0.53"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.155 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.25 0.53"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
  </joint>
  <link name="motor_front_left_bb">
