    <child link="ZED_X_Mini_camera"/>
    <origin xyz="0 0.38 0.14" rpy="0 0 0"/>
  </joint>
  <link name="camera_right">
  </link>
  <joint name="ZED_X_Mini_camera_camera_right_joint" type="fixed">
    <parent link="ZED_X_Mini_camera"/>
    <child link="camera_right"/>
    <!-- Optical frame (x right, y down, z forward): yaw pi flips the parent's
         (left, up, forward) axes. camera_right is on the vehicle's right. -->
    <origin xyz="-0.025 0.003 0" rpy="0 0 3.14159265"/>
  </joint>
  <link name="camera_left">
