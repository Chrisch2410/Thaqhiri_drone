# Settings for `docker compose up` (and the world of start_windows.cmd).
# Copy to .env and edit; .env is not committed.

# Host setup (docker/platforms/<value>.yml):
#   linux  Ubuntu with an NVIDIA GPU; run `xhost +local:` once per login.
#   wsl    Windows + Docker Desktop, Webots in the container; works from
#          PowerShell, cmd or a WSL shell.
# Windows with Webots running natively: use start_windows.cmd instead.
HOST_PLATFORM=linux

# World in src/thaqhiri_sim_webots/worlds: mine_test_arena.wbt or cerro_rico.wbt
WORLD=mine_test_arena.wbt

# Extra launch arguments (name:=value, space-separated), e.g.
#   SIM_ARGS=gui:=false rviz:=false rtabmap_viz:=false   fastest, no windows
#   SIM_ARGS=rtabmap:=false camera_rate:=25
SIM_ARGS=

# false: the container only builds; launch yourself with
# `docker compose exec sim bash` and then `sim`.
SIM_AUTOSTART=true

# wsl: GPU used for OpenGL (part of the adapter name, e.g. NVIDIA, AMD, Intel).
WSL_GPU_ADAPTER=NVIDIA
